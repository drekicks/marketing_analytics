    <worksheet name='KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='campaign_segment_performance' name='federated.1u8yx7i1mztp0h111pmfe0m7nht8' />
          </datasources>
          <datasource-dependencies datasource='federated.1u8yx7i1mztp0h111pmfe0m7nht8'>
            <column caption='Expected Revenue' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_2153417067134979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Test RPC (copy)_2650945906757648]*sum([test_group])' />
            </column>
            <column caption='Incremental Rev Test Group' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2153417067790340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([test_campaign_revenue])-[Calculation_2153417067134979]' />
              <desc>
                <formatted-text>
                  <run>Incremental revenue generated by the full Test group</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Incremental ROMI Test Group' datatype='real' default-format='p0%' name='[Calculation_2153417068167173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Calculation_2153417067790340]-[Calculation_2650945895981070])/[Calculation_2650945895981070])' />
            </column>
            <column caption='Absolute Lift' datatype='real' default-format='p0.00%' name='[Calculation_2650945882537990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Control Conversion Rate (copy)_2650945890619402]-[Calculation_2650945886720009]' />
            </column>
            <column caption='Control Conversion Rate' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_2650945886720009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([control_cnvrsn])/sum([control_group])' />
            </column>
            <column caption='Incremental Conversions' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2650945892085771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([test_group])*[Calculation_2650945882537990]' />
              <desc>
                <formatted-text>
                  <run>Incremental revenue for the additional 34 customers.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Campaign Costs' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2650945895981070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offer_cost]+ [contact_cost])' />
            </column>
            <column caption='Test Conversion Rate' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Control Conversion Rate (copy)_2650945890619402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([test_cnvrsn])/sum([test_group])' />
            </column>
            <column caption='Control RPC' datatype='real' default-format='C1033%' name='[Test RPC (copy)_2650945906757648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([control_campaign_revenue])/sum([control_group])' />
            </column>
            <column caption='Campaign Revenue' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[campaign_revenue]' role='measure' type='quantitative' />
            <column caption='Contact Cost' datatype='real' name='[contact_cost]' role='measure' type='quantitative' />
            <column caption='Control Campaign Revenue' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[control_campaign_revenue]' role='measure' type='quantitative' />
            <column caption='Control Cnvrsn' datatype='integer' name='[control_cnvrsn]' role='measure' type='quantitative' />
            <column caption='Control Group Contacts' datatype='integer' name='[control_group]' role='measure' type='quantitative' />
            <column caption='Customer Segment' datatype='string' name='[customer_segment]' role='dimension' type='nominal' />
            <column caption='Offer Cost' datatype='real' name='[offer_cost]' role='measure' type='quantitative' />
            <column-instance column='[campaign_revenue]' derivation='Sum' name='[sum:campaign_revenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_cnvrsn]' derivation='Sum' name='[sum:total_cnvrsn:qk]' pivot='key' type='quantitative' />
            <column caption='Test Campaign Revenue' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[test_campaign_revenue]' role='measure' type='quantitative' />
            <column caption='Test Cnvrsn' datatype='integer' name='[test_cnvrsn]' role='measure' type='quantitative' />
