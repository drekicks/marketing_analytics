# --- OpenAI (required: the app refuses to start without both) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_model_name

# --- Data source ---
# postgres = read the dbt marts from the database below (Neon in production)
# csv      = offline fallback using the snapshots in data/demo/
DATA_SOURCE=postgres

# Schema holding the dbt marts and seeds (dbt target schema + "_analytics")
ANALYTICS_SCHEMA=dbt_dev_analytics

# --- Database (Neon or local Postgres) ---
# Also required in csv mode for knowledge (RAG) questions.
DB_HOST=your-endpoint.region.aws.neon.tech
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password
# Neon requires SSL; leave empty for a local database without SSL.
DB_SSLMODE=require

# --- dbt (read by marketing_analytics_dbt/profiles.example.yml, not by the app) ---
NEON_DB_HOST=your-endpoint.region.aws.neon.tech
NEON_DB_USER=your_username
NEON_DB_PASSWORD=your_password
NEON_DB_NAME=your_database
